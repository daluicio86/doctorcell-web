<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Dominio principal sin www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.doctorcell\.com\.ec(?::\d+)?$" />
          </conditions>
          <action type="Redirect" url="https://doctorcell.com.ec/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="HTTPS en dominio principal" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^doctorcell\.com\.ec(?::\d+)?$" />
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://doctorcell.com.ec/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Retirar Lead Generation" stopProcessing="true">
          <match url="^lead-generation/?$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Retirar sorteo finalizado" stopProcessing="true">
          <match url="^terminos-rifa/?$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Retirar Cursos" stopProcessing="true">
          <match url="^(cursos|curso|courses)/?$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>
    <httpPlatform processPath="node" arguments="server.mjs" startupTimeLimit="30" startupRetryCount="2" stdoutLogEnabled="false">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="DOCTORCELL_STATIC_DIR" value="dist" />
      </environmentVariables>
    </httpPlatform>
    <security><requestFiltering><hiddenSegments>
      <add segment="data" /><add segment="server" /><add segment="node_modules" />
    </hiddenSegments></requestFiltering></security>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
